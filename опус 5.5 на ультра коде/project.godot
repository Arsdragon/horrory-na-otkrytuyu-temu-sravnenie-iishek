; Engine configuration file.
config_version=5

[application]

config/name="Третий пар"
config/description="Хоррор от первого лица. Баня №3, ночь на 22 декабря."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="TretiyPar"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Settings="*res://src/core/settings.gd"
Game="*res://src/core/game.gd"
Snd="*res://src/core/snd.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/PTSans-Regular.ttf"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="doors"
3d_physics/layer_4="interact"
3d_physics/layer_5="monster"
3d_physics/layer_6="triggers"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
