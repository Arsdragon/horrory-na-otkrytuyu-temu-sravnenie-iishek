static func note(id: String) -> Dictionary:
	if _notes.is_empty():
		var f := FileAccess.open("res://src/story/notes.json", FileAccess.READ)
		if f:
			_notes = JSON.parse_string(f.get_as_text())
	return _notes.get(id, {"title": id, "text": ""})


static func all_notes() -> Array:
	note("rules")
	return _notes.keys()
